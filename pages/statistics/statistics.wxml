<view class="page">
  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载统计数据...</text>
  </view>

  <block wx:else>
    <!-- Dashboard summary cards -->
    <view class="summary-row" wx:if="{{dashboard}}">
      <view class="summary-card">
        <text class="summary-val">{{dashboard.monthlyReservations || dashboard.monthlyCount || 0}}</text>
        <text class="summary-label">本月预约</text>
      </view>
      <view class="summary-card">
        <text class="summary-val">{{utilization.overallUtilization || utilization.overallRate || 0}}%</text>
        <text class="summary-label">整体利用率</text>
      </view>
      <view class="summary-card">
        <text class="summary-val">{{dashboard.weeklyActiveUsers || dashboard.activeUsers || 0}}</text>
        <text class="summary-label">本周活跃</text>
      </view>
    </view>

    <!-- Seat utilization chart -->
    <view class="section">
      <view class="section-title">近{{utilization.analysisDays || 30}}天座位利用率</view>
      <view class="section-sub">
        <text>预约率 {{utilization.overallUtilization || utilization.overallRate || 0}}%</text>
        <text class="sub-divider">|</text>
        <text class="sub-actual">实际使用率 {{utilization.overallActualUtilization || 0}}%</text>
      </view>
      <view class="chart-legend">
        <view class="legend-item"><view class="legend-dot legend-reserve"></view><text>预约利用率</text></view>
        <view class="legend-item"><view class="legend-dot legend-actual"></view><text>实际使用率</text></view>
      </view>
      <view class="chart-wrap">
        <canvas type="2d" id="utilChart" class="util-canvas"></canvas>
      </view>
    </view>

    <!-- Popular seats -->
    <view class="section">
      <view class="section-title">热门座位排行</view>
      <view class="section-sub">预约次数排名前 {{popularSeats.length}} 的座位</view>
      <view class="rank-list" wx:if="{{popularSeats.length > 0}}">
        <view class="rank-item" wx:for="{{popularSeats}}" wx:key="seatNumber">
          <view class="rank-index">{{index + 1}}</view>
          <view class="rank-info">
            <text class="rank-name">{{item.seatNumber || item.seatName || item.name}}</text>
            <text class="rank-count">{{item.reservationCount || item.count || 0}} 次预约</text>
          </view>
          <view class="rank-bar-track">
            <view class="rank-bar-fill" style="width: {{item._percent || 0}}%;"></view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-tip">暂无热门座位数据</view>
    </view>

    <!-- Error / empty state -->
    <view wx:if="{{!dashboard && !utilization && popularSeats.length === 0}}" class="empty-wrap">
      <text class="empty-text">暂无统计数据</text>
    </view>
  </block>
</view>
